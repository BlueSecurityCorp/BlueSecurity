---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/index';
import { localePath } from '../i18n/index';
import { t } from '../i18n/ui';
import { getNewsCategoryLabel, getNewsTemplateLabel } from '../data/news';

interface Props {
  news: CollectionEntry<'news'>;
  lang: Locale;
}

const { news, lang } = Astro.props;
const { Content } = await render(news);
const categoryLabel = getNewsCategoryLabel(news.data.category, lang);
const templateLabel = getNewsTemplateLabel(news.data.template, lang);
const locale = lang === 'ko' ? 'ko-KR' : 'en-US';

function formatDate(date: string): string {
  return new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date(date));
}

function slugFromId(id: string): string {
  return id.replace(/\.mdx?$/, '');
}

const relatedNews = (await getCollection('news'))
  .filter((item) => {
    if (item.id === news.id || item.id.split('/').pop()?.startsWith('_')) return false;
    return item.data.published && item.data.lang === lang;
  })
  .sort((a, b) => {
    const aMatches = a.data.category === news.data.category ? 1 : 0;
    const bMatches = b.data.category === news.data.category ? 1 : 0;
    return bMatches - aMatches || new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3);

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: news.data.title,
  description: news.data.description,
  datePublished: news.data.date,
  dateModified: news.data.updated ?? news.data.date,
  inLanguage: lang,
  mainEntityOfPage: canonicalURL,
  publisher: { '@type': 'Organization', name: 'BlueSecurity' },
  ...(news.data.image ? { image: new URL(news.data.image, Astro.site ?? Astro.url.origin).toString() } : {}),
};
---

<div data-pagefind-body>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <section class="article-head">
    <div class="head-glow" aria-hidden="true"></div>
    <div class="article-container head-inner">
      <a href={localePath('/news', lang)} class="back-link">
        <span aria-hidden="true">←</span>
        {t('news.back', lang)}
      </a>

      <div class="article-labels">
        <span class="category-label">{templateLabel}</span>
        {news.data.newsletterIssue && <span class="issue-label">Newsletter #{news.data.newsletterIssue}</span>}
      </div>

      <h1>{news.data.title}</h1>
      <p class="article-summary">{news.data.description}</p>

      <div class="article-meta">
        <time datetime={news.data.date}>{t('news.publishedAt', lang)} · {formatDate(news.data.date)}</time>
        {news.data.updated && <time datetime={news.data.updated}>{t('news.updatedAt', lang)} · {formatDate(news.data.updated)}</time>}
        <button type="button" class="share-button" data-share-button data-share-label={t('news.share', lang)} data-copied-label={t('news.copied', lang)}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="18" cy="5" r="2.5" stroke="currentColor" stroke-width="1.5" />
            <circle cx="6" cy="12" r="2.5" stroke="currentColor" stroke-width="1.5" />
            <circle cx="18" cy="19" r="2.5" stroke="currentColor" stroke-width="1.5" />
            <path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>{t('news.share', lang)}</span>
        </button>
      </div>
    </div>
  </section>

  <main class="article-main">
    <div class="article-container article-layout">
      <article class="article-content">
        {news.data.image && (
          <figure class="article-cover">
            <img src={news.data.image} alt="" />
          </figure>
        )}
        <Content />

        {news.data.source && (
          <div class="source-card">
            <div>
              <span>{t('news.source', lang)}</span>
              <strong>{news.data.source.name}</strong>
            </div>
            <a href={news.data.source.url} target="_blank" rel="noopener noreferrer">
              {lang === 'ko' ? '원문 보기' : 'View source'}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        )}
      </article>

      <aside class="article-aside" aria-label={lang === 'ko' ? '기사 정보' : 'Article information'}>
        <div class="aside-card">
          <p>{lang === 'ko' ? '콘텐츠 정보' : 'Article info'}</p>
          <dl>
            <div>
              <dt>{t('news.filter.template', lang)}</dt>
              <dd>{templateLabel}</dd>
            </div>
            <div>
              <dt>{lang === 'ko' ? '카테고리' : 'Category'}</dt>
              <dd>{categoryLabel}</dd>
            </div>
            <div>
              <dt>{t('news.publishedAt', lang)}</dt>
              <dd>{formatDate(news.data.date)}</dd>
            </div>
          </dl>
          {news.data.tags.length > 0 && (
            <div class="aside-tags">
              {news.data.tags.map((tag) => <span>#{tag}</span>)}
            </div>
          )}
        </div>
      </aside>
    </div>
  </main>

  {relatedNews.length > 0 && (
    <section class="related-section" aria-labelledby="related-heading">
      <div class="article-container">
        <div class="related-heading-row">
          <div>
            <span>MORE FROM BLUESECURITY</span>
            <h2 id="related-heading">{t('news.related', lang)}</h2>
          </div>
          <a href={localePath('/news', lang)}>{t('news.back', lang)} <span aria-hidden="true">→</span></a>
        </div>

        <div class="related-grid">
          {relatedNews.map((item) => (
            <a href={localePath(`/news/${slugFromId(item.id)}`, lang)} class="related-card">
              <span>{getNewsCategoryLabel(item.data.category, lang)}</span>
              <h3>{item.data.title}</h3>
              <time datetime={item.data.date}>{formatDate(item.data.date)}</time>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</div>

<script>
  document.querySelectorAll('[data-share-button]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector('span');
      try {
        if (navigator.share) {
          await navigator.share({ title: document.title, url: window.location.href });
          return;
        }
        await navigator.clipboard.writeText(window.location.href);
        label.textContent = button.dataset.copiedLabel;
        window.setTimeout(() => { label.textContent = button.dataset.shareLabel; }, 1800);
      } catch (error) {
        if (error?.name !== 'AbortError') {
          label.textContent = button.dataset.shareLabel;
        }
      }
    });
  });
</script>

<style>
  .article-container { width: min(980px, calc(100% - 3rem)); margin: 0 auto; }

  .article-head {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--bs-color-border-default);
    background: var(--bs-color-surface-default);
    padding: 3.5rem 0 3.8rem;
  }

  .head-glow {
    position: absolute;
    top: -260px;
    left: 40%;
    width: 560px;
    height: 560px;
    border-radius: 50%;
    background: var(--bs-color-primary-subtle);
    filter: blur(80px);
  }

  .head-inner { position: relative; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--bs-color-text-tertiary);
    font-size: var(--bs-font-size-body-4);
    font-weight: var(--bs-font-weight-semibold);
    text-decoration: none;
    transition: color var(--bs-duration-fast) var(--bs-ease-standard);
  }

  .back-link:hover { color: var(--bs-color-primary); }
  .article-labels { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2.2rem; }

  .category-label,
  .issue-label {
    display: inline-flex;
    border: 1px solid var(--bs-color-border-default);
    border-radius: 999px;
    background: var(--bs-color-primary-subtle);
    padding: 0.35rem 0.68rem;
    color: var(--bs-color-primary);
    font-size: var(--bs-font-size-body-4);
    font-weight: var(--bs-font-weight-bold);
  }

  .issue-label { border-color: var(--bs-color-border-default); background: var(--bs-color-surface-subtle); color: var(--bs-color-text-tertiary); }

  h1 {
    max-width: 860px;
    margin: 1.15rem 0 0;
    color: var(--bs-color-text-primary);
    font-size: var(--bs-font-size-display-2);
    font-weight: var(--bs-font-weight-display);
    line-height: var(--bs-line-height-display);
    letter-spacing: -0.04em;
  }

  .article-summary {
    max-width: 740px;
    margin: 1.3rem 0 0;
    color: var(--bs-color-text-secondary);
    font-size: var(--bs-font-size-body-1);
    line-height: var(--bs-line-height-relaxed);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.2rem;
    margin-top: 1.8rem;
    color: var(--bs-color-text-tertiary);
    font-size: var(--bs-font-size-body-4);
  }

  .share-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    border: 1px solid var(--bs-color-border-default);
    border-radius: var(--bs-radius-lg);
    background: var(--bs-color-secondary);
    padding: 0.48rem 0.7rem;
    color: var(--bs-color-on-secondary);
    font: inherit;
    font-weight: 650;
    cursor: pointer;
    transition: border-color var(--bs-duration-fast) var(--bs-ease-standard), color var(--bs-duration-fast) var(--bs-ease-standard), background var(--bs-duration-fast) var(--bs-ease-standard);
  }

  .share-button:hover { border-color: var(--bs-color-primary); color: var(--bs-color-primary); background: var(--bs-color-secondary-hover); }

  .article-main { background: var(--bs-color-surface-canvas); padding: 3.5rem 0 5rem; }
  .article-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }

  .article-content {
    min-width: 0;
    color: var(--bs-color-text-secondary);
    font-size: var(--bs-font-size-body-2);
    line-height: var(--bs-line-height-relaxed);
  }

  .article-cover {
    overflow: hidden;
    margin: 0 0 2.5rem;
    border: 1px solid var(--bs-color-border-default);
    border-radius: var(--bs-radius-xl);
  }

  .article-cover img { display: block; width: 100%; height: auto; }
  .article-content :global(h2) { margin: 2.8rem 0 1rem; color: var(--bs-color-text-primary); font-size: var(--bs-font-size-title-1); font-weight: var(--bs-font-weight-title); line-height: var(--bs-line-height-title); letter-spacing: -0.025em; }
  .article-content :global(h3) { margin: 2.2rem 0 0.8rem; color: var(--bs-color-text-primary); font-size: var(--bs-font-size-title-2); font-weight: var(--bs-font-weight-title); }
  .article-content :global(p), .article-content :global(ul), .article-content :global(ol), .article-content :global(blockquote) { margin: 1.15rem 0; }
  .article-content :global(ul), .article-content :global(ol) { padding-left: 1.35rem; }
  .article-content :global(li + li) { margin-top: 0.45rem; }
  .article-content :global(strong) { color: var(--bs-color-text-primary); font-weight: var(--bs-font-weight-semibold); }
  .article-content :global(a) { color: var(--bs-color-text-link); text-decoration-color: color-mix(in srgb, var(--bs-color-text-link) 45%, transparent); text-underline-offset: 3px; }
  .article-content :global(blockquote) { border-left: 2px solid var(--bs-color-primary); background: var(--bs-color-primary-subtle); padding: 0.9rem 1.2rem; color: var(--bs-color-text-secondary); }
  .article-content :global(code) { border: 1px solid var(--bs-color-border-default); border-radius: var(--bs-radius-sm); background: var(--bs-color-surface-subtle); padding: 0.12rem 0.34rem; color: var(--bs-color-text-primary); font-family: var(--bs-font-family-code); font-size: 0.88em; }
  .article-content :global(pre) { overflow-x: auto; border: 1px solid var(--bs-color-border-default); border-radius: var(--bs-radius-lg); background: var(--bs-color-surface-default); padding: 1rem; }
  .article-content :global(pre code) { border: 0; background: transparent; padding: 0; }
  .article-content :global(img) { max-width: 100%; border-radius: 0.65rem; }

  .source-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    border: 1px solid var(--bs-color-border-default);
    border-radius: var(--bs-radius-lg);
    background: var(--bs-color-surface-default);
    padding: 1rem 1.1rem;
  }

  .source-card div { display: flex; flex-direction: column; gap: 0.2rem; }
  .source-card div span { color: var(--bs-color-text-tertiary); font-size: var(--bs-font-size-body-4); font-weight: var(--bs-font-weight-semibold); }
  .source-card strong { color: var(--bs-color-text-primary); font-size: var(--bs-font-size-body-3); }
  .source-card a { flex: 0 0 auto; color: var(--bs-color-text-link); font-size: var(--bs-font-size-body-4); font-weight: var(--bs-font-weight-semibold); text-decoration: none; }

  .article-aside { display: none; }
  .aside-card { position: sticky; top: 88px; border-left: 1px solid var(--bs-color-border-default); padding-left: 1.4rem; }
  .aside-card > p { margin: 0 0 1rem; color: var(--bs-color-text-tertiary); font-size: var(--bs-font-size-body-4); font-weight: var(--bs-font-weight-bold); letter-spacing: 0.08em; text-transform: uppercase; }
  .aside-card dl, .aside-card dl div { display: flex; flex-direction: column; gap: 0.22rem; }
  .aside-card dl { gap: 1rem; margin: 0; }
  .aside-card dt { color: var(--bs-color-text-tertiary); font-size: var(--bs-font-size-body-4); }
  .aside-card dd { margin: 0; color: var(--bs-color-text-secondary); font-size: var(--bs-font-size-body-4); }
  .aside-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 1.2rem; }
  .aside-tags span { border-radius: var(--bs-radius-md); background: var(--bs-color-surface-subtle); padding: 0.28rem 0.42rem; color: var(--bs-color-text-tertiary); font-size: var(--bs-font-size-body-4); }

  .related-section { border-top: 1px solid var(--bs-color-border-default); background: var(--bs-color-surface-default); padding: 3.5rem 0 5rem; }
  .related-heading-row { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .related-heading-row div > span { color: var(--bs-color-text-tertiary); font-size: var(--bs-font-size-body-4); font-weight: var(--bs-font-weight-bold); letter-spacing: 0.12em; }
  .related-heading-row h2 { margin: 0.4rem 0 0; color: var(--bs-color-text-primary); font-size: var(--bs-font-size-title-2); font-weight: var(--bs-font-weight-title); }
  .related-heading-row > a { color: var(--bs-color-text-link); font-size: var(--bs-font-size-body-4); font-weight: var(--bs-font-weight-semibold); text-decoration: none; }
  .related-grid { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  .related-card { display: flex; flex-direction: column; min-height: 150px; border: 1px solid var(--bs-color-border-default); border-radius: var(--bs-radius-lg); background: var(--bs-color-surface-default); padding: 1.1rem; color: inherit; text-decoration: none; transition: border-color var(--bs-duration-normal) var(--bs-ease-standard), transform var(--bs-duration-normal) var(--bs-ease-standard); }
  .related-card:hover { transform: translateY(-2px); border-color: var(--bs-color-primary); box-shadow: var(--bs-shadow-sm); }
  .related-card > span { color: var(--bs-color-primary); font-size: var(--bs-font-size-body-4); font-weight: var(--bs-font-weight-semibold); }
  .related-card h3 { margin: 0.65rem 0; color: var(--bs-color-text-primary); font-size: var(--bs-font-size-body-2); font-weight: var(--bs-font-weight-semibold); line-height: var(--bs-line-height-body); }
  .related-card time { margin-top: auto; color: var(--bs-color-text-tertiary); font-size: var(--bs-font-size-body-4); }

  @media (min-width: 800px) {
    .article-layout { grid-template-columns: minmax(0, 1fr) 185px; gap: 3.5rem; }
    .article-aside { display: block; }
    .related-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 639px) {
    .article-container { width: min(100% - 2rem, 980px); }
    .article-head { padding: 2.5rem 0 3rem; }
    .article-main { padding-top: 2.5rem; }
    .share-button { width: 100%; justify-content: center; margin-top: 0.4rem; margin-left: 0; }
    .source-card { align-items: flex-start; flex-direction: column; }
  }
</style>
