---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/index';
import { localePath } from '../i18n/index';
import { t } from '../i18n/ui';
import { getNewsCategoryLabel, getNewsCategoryOptions, getNewsTemplateLabel } from '../data/news';
import { previewNews } from '../data/previewNews';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const publishedNews = (await getCollection('news'))
  .filter((item) => {
    if (item.id.split('/').pop()?.startsWith('_')) return false;
    return item.data.published && item.data.lang === lang;
  })
  .map((item) => ({
    id: item.id,
    title: item.data.title,
    description: item.data.description,
    date: item.data.date,
    category: item.data.category,
    categoryLabel: getNewsCategoryLabel(item.data.category, lang),
    templateLabel: getNewsTemplateLabel(item.data.template, lang),
    tags: item.data.tags,
    featured: item.data.featured,
    image: item.data.image,
    newsletterIssue: item.data.newsletterIssue,
    href: localePath(`/news/${slugFromId(item.id)}`, lang),
  }));

const previewNewsItems = lang === 'ko'
  ? previewNews.map((item) => ({
    id: item.slug,
    title: item.title,
    description: item.description,
    date: item.date,
    category: item.category,
    categoryLabel: getNewsCategoryLabel(item.category, lang),
    templateLabel: getNewsTemplateLabel(item.template, lang),
    tags: [...item.tags],
    featured: item.featured,
    image: undefined,
    newsletterIssue: undefined,
    href: `/news/${item.slug}`,
  }))
  : [];

const newsItems = [...previewNewsItems, ...publishedNews]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const categoryOptions = getNewsCategoryOptions(lang);

function slugFromId(id: string): string {
  return id.replace(/\.mdx?$/, '');
}

function formatDate(date: string): string {
  return new Intl.DateTimeFormat(lang === 'ko' ? 'ko-KR' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(new Date(date));
}
---

<section class="news-section" aria-labelledby="news-list-heading">
  <div class="news-container" data-news-board data-count-suffix={t('news.count', lang)}>
    <h2 id="news-list-heading" class="sr-only">{t('news.heading', lang)}</h2>

    <div class="published-heading">
      <h2>{t('news.published.heading', lang)}</h2>
      <span>{t('news.published.subtitle', lang)}</span>
    </div>

    <div class="news-toolbar">
      <label class="search-field">
        <span class="sr-only">{t('news.search', lang)}</span>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
          <path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <input type="search" placeholder={t('news.search.placeholder', lang)} data-news-search />
      </label>

      <label class="filter-field category-filter">
        <span>{t('news.filter.category', lang)}</span>
        <select data-news-category>
          <option value="">{t('news.filter.all', lang)}</option>
          {categoryOptions.map((category) => (
            <option value={category.id}>{category.label}</option>
          ))}
        </select>
      </label>

      <div class="date-filter" role="group" aria-label={t('news.filter.date', lang)}>
        <label class="filter-field date-field">
          <span>{t('news.filter.dateFrom', lang)}</span>
          <input type="date" data-news-date-from />
        </label>
        <span class="date-separator" aria-hidden="true">–</span>
        <label class="filter-field date-field">
          <span>{t('news.filter.dateTo', lang)}</span>
          <input type="date" data-news-date-to />
        </label>
      </div>

      <button type="button" class="filter-reset" data-news-reset>{t('news.filter.reset', lang)}</button>

    </div>

    <div class="news-summary" aria-live="polite">
      <span class="summary-dot" aria-hidden="true"></span>
      <span data-news-count>{newsItems.length} {t('news.count', lang)}</span>
    </div>

    {newsItems.length > 0 ? (
      <div class="news-grid" data-news-list>
        {newsItems.map((item) => {
          const searchText = [item.title, item.description, item.categoryLabel, item.templateLabel, ...item.tags].join(' ').toLocaleLowerCase();

          return (
            <article
              class:list={['news-card', { featured: item.featured }]}
              data-news-card
              data-search={searchText}
              data-category={item.category}
              data-date={item.date}
            >
              <a href={item.href}>
                <div class:list={['news-visual', `category-${item.category}`]}>
                  {item.image ? (
                    <img src={item.image} alt="" loading="lazy" />
                  ) : (
                    <div class="visual-art" aria-hidden="true">
                      <span class="orb orb-one"></span>
                      <span class="orb orb-two"></span>
                      <svg viewBox="0 0 72 72" fill="none">
                        <path d="M18 18.5h36v35H18z" stroke="currentColor" stroke-width="1.5" />
                        <path d="M25 28h22M25 35h22M25 42h13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        <path d="M43 42h4v4h-4z" fill="currentColor" />
                      </svg>
                    </div>
                  )}
                  <span class="visual-category">{item.templateLabel}</span>
                  {item.featured && <span class="featured-badge">{t('news.featured', lang)}</span>}
                </div>

                <div class="news-card-body">
                  <div class="news-meta">
                    <span>{item.categoryLabel}</span>
                    <span class="meta-divider" aria-hidden="true"></span>
                    <time datetime={item.date}>{formatDate(item.date)}</time>
                    {item.newsletterIssue && <span>#{item.newsletterIssue}</span>}
                  </div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <div class="news-card-footer">
                    <div class="tag-list" aria-label={lang === 'ko' ? '태그' : 'Tags'}>
                      {item.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
                    </div>
                    <span class="read-more">
                      {t('news.read', lang)}
                      <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-icon" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
            <path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <p>{t('news.empty', lang)}</p>
      </div>
    )}

    <div class="empty-state" data-news-no-results hidden>
      <div class="empty-icon" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5" />
          <path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </div>
      <p>{t('news.noResults', lang)}</p>
    </div>

    <nav
      class="news-pagination"
      data-news-pagination
      data-prev-label={t('news.pagination.prev', lang)}
      data-next-label={t('news.pagination.next', lang)}
      data-page-label={t('news.pagination.page', lang)}
      aria-label={t('news.pagination.label', lang)}
      hidden
    >
      <button type="button" class="pagination-direction" data-news-prev>
        <span aria-hidden="true">←</span>
        {t('news.pagination.prev', lang)}
      </button>
      <div class="pagination-pages" data-news-pages></div>
      <button type="button" class="pagination-direction" data-news-next>
        {t('news.pagination.next', lang)}
        <span aria-hidden="true">→</span>
      </button>
    </nav>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-news-board]').forEach((board) => {
    const searchInput = board.querySelector<HTMLInputElement>('[data-news-search]');
    const categorySelect = board.querySelector<HTMLSelectElement>('[data-news-category]');
    const dateFromInput = board.querySelector<HTMLInputElement>('[data-news-date-from]');
    const dateToInput = board.querySelector<HTMLInputElement>('[data-news-date-to]');
    const resetButton = board.querySelector<HTMLButtonElement>('[data-news-reset]');
    const cards = Array.from(board.querySelectorAll<HTMLElement>('[data-news-card]'));
    const count = board.querySelector('[data-news-count]');
    const noResults = board.querySelector<HTMLElement>('[data-news-no-results]');
    const pagination = board.querySelector<HTMLElement>('[data-news-pagination]');
    const prevButton = board.querySelector<HTMLButtonElement>('[data-news-prev]');
    const nextButton = board.querySelector<HTMLButtonElement>('[data-news-next]');
    const pages = board.querySelector<HTMLElement>('[data-news-pages]');
    const pageSize = 6;
    let currentPage = 1;

    const getFilteredCards = () => {
      const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
      const category = categorySelect?.value ?? '';
      const dateFrom = dateFromInput?.value ?? '';
      const dateTo = dateToInput?.value ?? '';

      return cards.filter((card) => {
        const searchMatches = !query || (card.dataset.search ?? '').includes(query);
        const categoryMatches = !category || card.dataset.category === category;
        const date = card.dataset.date ?? '';
        const fromMatches = !dateFrom || date >= dateFrom;
        const toMatches = !dateTo || date <= dateTo;
        return searchMatches && categoryMatches && fromMatches && toMatches;
      });
    };

    const renderPagination = (pageCount: number) => {
      if (!pagination || !pages || !prevButton || !nextButton) return;

      pagination.hidden = pageCount <= 1;
      prevButton.disabled = currentPage === 1;
      nextButton.disabled = currentPage === pageCount;
      pages.replaceChildren();

      for (let page = 1; page <= pageCount; page += 1) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'pagination-page';
        button.textContent = String(page);
        button.setAttribute('aria-label', `${pagination.dataset.pageLabel ?? 'Page'} ${page}`);
        if (page === currentPage) {
          button.classList.add('active');
          button.setAttribute('aria-current', 'page');
        }
        button.addEventListener('click', () => {
          currentPage = page;
          update(false);
        });
        pages.append(button);
      }
    };

    const update = (resetPage = true) => {
      if (resetPage) currentPage = 1;
      const filteredCards = getFilteredCards();
      const pageCount = Math.max(1, Math.ceil(filteredCards.length / pageSize));
      currentPage = Math.min(currentPage, pageCount);
      const startIndex = (currentPage - 1) * pageSize;
      const visibleCards = new Set(filteredCards.slice(startIndex, startIndex + pageSize));

      cards.forEach((card) => {
        card.hidden = !visibleCards.has(card);
      });

      if (count) count.textContent = `${filteredCards.length} ${board.dataset.countSuffix}`;
      if (noResults) noResults.hidden = filteredCards.length > 0 || cards.length === 0;
      renderPagination(filteredCards.length > 0 ? pageCount : 0);
    };

    searchInput?.addEventListener('input', () => update());
    categorySelect?.addEventListener('change', () => update());
    dateFromInput?.addEventListener('change', () => update());
    dateToInput?.addEventListener('change', () => update());
    resetButton?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (categorySelect) categorySelect.value = '';
      if (dateFromInput) dateFromInput.value = '';
      if (dateToInput) dateToInput.value = '';
      update();
    });
    prevButton?.addEventListener('click', () => {
      if (currentPage <= 1) return;
      currentPage -= 1;
      update(false);
    });
    nextButton?.addEventListener('click', () => {
      const pageCount = Math.max(1, Math.ceil(getFilteredCards().length / pageSize));
      if (currentPage >= pageCount) return;
      currentPage += 1;
      update(false);
    });

    update();
  });
</script>

<style>
  .news-section {
    border-top: 1px solid rgba(51, 65, 85, 0.55);
    background: #080d18;
    padding: 2.5rem 0 6rem;
  }

  .news-container {
    width: min(1200px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .news-toolbar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-bottom: 1px solid rgba(51, 65, 85, 0.65);
    padding-bottom: 1.5rem;
  }

  .filter-field {
    display: grid;
    min-height: 52px;
    border: 1px solid #263148;
    border-radius: 0.7rem;
    background: #0c1220;
    padding: 0.38rem 0.75rem 0.35rem;
    color: #64748b;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .filter-field:focus-within {
    border-color: rgba(96, 165, 250, 0.7);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.08);
  }

  .filter-field > span {
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .filter-field select,
  .filter-field input {
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #dbe5f3;
    font: inherit;
    font-size: 0.78rem;
    color-scheme: dark;
  }

  .filter-field select {
    cursor: pointer;
  }

  .category-filter {
    width: 100%;
  }

  .date-filter {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
  }

  .date-field {
    flex: 1 1 0;
  }

  .date-separator {
    flex: 0 0 auto;
    color: #526078;
  }

  .filter-reset {
    min-height: 52px;
    border: 1px solid #263148;
    border-radius: 0.7rem;
    background: transparent;
    padding: 0 1rem;
    color: #8190a6;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 650;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .filter-reset:hover {
    border-color: rgba(96, 165, 250, 0.5);
    background: rgba(59, 130, 246, 0.08);
    color: #bfdbfe;
  }

  .published-heading { margin-bottom: 1.7rem; }
  .published-heading p { margin: 0 0 0.55rem; color: #60a5fa; font-size: 0.66rem; font-weight: 750; letter-spacing: 0.14em; text-transform: uppercase; }
  .published-heading h2 { margin: 0; color: #f1f5f9; font-size: 1.7rem; font-weight: 650; letter-spacing: -0.025em; }
  .published-heading span { display: block; margin-top: 0.55rem; color: #718096; font-size: 0.85rem; line-height: 1.6; }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    border: 1px solid #263148;
    border-radius: 0.7rem;
    background: #0c1220;
    padding: 0 0.9rem;
    color: #64748b;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-field:focus-within {
    border-color: rgba(96, 165, 250, 0.7);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.08);
  }

  .search-field input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0.8rem 0;
    color: #e2e8f0;
    font: inherit;
    font-size: 0.875rem;
  }

  .search-field input::placeholder {
    color: #526078;
  }

  .news-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.25rem;
    margin: 1.5rem 0 1rem;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .summary-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #3b82f6;
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.7);
  }

  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .news-card {
    min-width: 0;
    border: 1px solid #202a3d;
    border-radius: 0.85rem;
    background: #0c1220;
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .news-card:hover {
    transform: translateY(-3px);
    border-color: rgba(59, 130, 246, 0.42);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24);
  }

  .news-card[hidden] {
    display: none;
  }

  .news-card > a {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .news-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 170px;
    overflow: hidden;
    border-bottom: 1px solid rgba(51, 65, 85, 0.55);
    background: linear-gradient(145deg, #101b32, #0b1323);
    color: #60a5fa;
  }

  .news-visual.category-industry { color: #22d3ee; background: linear-gradient(145deg, #0c2330, #0a1621); }
  .news-visual.category-product { color: #818cf8; background: linear-gradient(145deg, #171831, #0e1224); }
  .news-visual.category-newsletter { color: #38bdf8; background: linear-gradient(145deg, #101e35, #0b1424); }

  .news-visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visual-art {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 170px;
    background-image: linear-gradient(rgba(148, 163, 184, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(148, 163, 184, 0.035) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .visual-art svg {
    position: relative;
    z-index: 2;
    width: 72px;
    filter: drop-shadow(0 0 18px currentColor);
    opacity: 0.82;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(1px);
  }

  .orb-one {
    width: 120px;
    height: 120px;
    background: currentColor;
    opacity: 0.08;
  }

  .orb-two {
    width: 220px;
    height: 80px;
    border: 1px solid currentColor;
    opacity: 0.1;
    transform: rotate(-18deg);
  }

  .visual-category,
  .featured-badge {
    position: absolute;
    z-index: 3;
    top: 0.85rem;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 999px;
    background: rgba(8, 13, 24, 0.72);
    padding: 0.32rem 0.58rem;
    color: #cbd5e1;
    font-size: 0.68rem;
    font-weight: 650;
    backdrop-filter: blur(8px);
  }

  .visual-category { left: 0.85rem; }
  .featured-badge { right: 0.85rem; color: #93c5fd; }

  .news-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem;
  }

  .news-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: #607089;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .news-meta > span:first-child { color: #60a5fa; }

  .meta-divider {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #334155;
  }

  .news-card h3 {
    margin: 0.8rem 0 0;
    color: #f1f5f9;
    font-size: 1.12rem;
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: -0.025em;
  }

  .news-card-body > p {
    display: -webkit-box;
    margin: 0.65rem 0 0;
    overflow: hidden;
    color: #8190a6;
    font-size: 0.84rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .news-card-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: #526078;
    font-size: 0.68rem;
  }

  .read-more {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.35rem;
    color: #64748b;
    font-size: 0.72rem;
    font-weight: 650;
    transition: color 0.2s ease;
  }

  .news-card:hover .read-more { color: #93c5fd; }
  .news-card:hover .read-more span { transform: translateX(2px); }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 260px;
    border: 1px dashed #263148;
    border-radius: 0.85rem;
    background: rgba(12, 18, 32, 0.6);
    color: #64748b;
    text-align: center;
  }

  .empty-state[hidden] { display: none; }

  .empty-icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    margin-bottom: 0.8rem;
    border: 1px solid #263148;
    border-radius: 50%;
    background: #0a1020;
    color: #526078;
  }

  .empty-state p { margin: 0; font-size: 0.9rem; }

  .news-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 2rem;
  }

  .news-pagination[hidden] { display: none; }

  .pagination-pages {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .pagination-direction,
  .pagination-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    border: 1px solid #263148;
    border-radius: 0.55rem;
    background: #0c1220;
    color: #8190a6;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 650;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .pagination-direction {
    gap: 0.35rem;
    padding: 0 0.75rem;
  }

  .pagination-direction:hover:not(:disabled),
  .pagination-page:hover,
  .pagination-page.active {
    border-color: rgba(96, 165, 250, 0.55);
    background: rgba(59, 130, 246, 0.12);
    color: #bfdbfe;
  }

  .pagination-direction:disabled {
    cursor: not-allowed;
    opacity: 0.38;
  }

  @media (min-width: 768px) {
    .news-toolbar {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }

    .search-field { flex: 1 1 280px; width: auto; }
    .category-filter { flex: 0 1 180px; width: auto; }
    .date-filter { flex: 1 1 340px; width: auto; }
