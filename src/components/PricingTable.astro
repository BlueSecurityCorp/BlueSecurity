---
import type { Locale } from '../i18n/index';
import codeBlueWordmark from '@bluesecuritycorp/brand/codeblue-wordmark.png';
import { localePath } from '../i18n/index';
import { t } from '../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = 'ko' } = Astro.props;
---

<section class="mx-auto w-full max-w-3xl" aria-labelledby="pricing-notice-heading">
  <div class="overflow-hidden rounded-lg border border-slate-800 bg-navy-900">
    <div class="flex flex-col gap-4 border-b border-slate-800 bg-slate-950/40 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="flex min-h-9 items-center">
        <img
          class="h-9 w-auto max-w-full object-contain object-left"
          src={codeBlueWordmark.src}
          alt="CodeBlue"
          width="180"
          height="36"
        />
      </p>
      <span class="w-fit rounded-md border border-blue-800 bg-blue-950/50 px-3 py-1 text-xs font-semibold text-blue-300">
        {t('pricing.status.badge', lang)}
      </span>
    </div>

    <div class="p-6 sm:p-8">
      <div class="flex h-11 w-11 items-center justify-center rounded-lg border border-slate-700 bg-slate-950 text-blue-300">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 2" />
        </svg>
      </div>

      <h2 id="pricing-notice-heading" class="mt-5 text-2xl font-semibold text-white sm:text-3xl">
        {t('pricing.status.heading', lang)}
      </h2>
      <p class="mt-3 max-w-2xl leading-7 text-slate-400">
        {t('pricing.status.description', lang)}
      </p>

      <a
        href={localePath('/contact', lang)}
        class="bs-marketing-action bs-marketing-action--primary mt-6"
      >
        {t('pricing.custom.cta', lang)}
      </a>
    </div>
  </div>
</section>
