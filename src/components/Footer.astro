---
import type { Locale } from '../i18n/index';
import blueSecurityWordmark from '@bluesecuritycorp/brand/bluesecurity-wordmark.png';
import codeBlueWordmark from '@bluesecuritycorp/brand/codeblue-wordmark.png';
import { localePath } from '../i18n/index';
import { t } from '../i18n/ui';
import { getCompany } from '../data/company';
import { getProductLineup } from '../data/products';

interface Props {
  lang?: Locale;
}

const { lang = 'ko' } = Astro.props;
const company = getCompany(lang);
const products = getProductLineup(lang);
const currentYear = new Date().getFullYear();

const companyLinks = [
  { href: localePath('/about', lang), label: t('nav.about', lang) },
  { href: localePath('/pricing', lang), label: t('nav.pricing', lang) },
  { href: localePath('/news', lang), label: t('nav.news', lang) },
  { href: localePath('/notices', lang), label: t('nav.notices', lang) },
  { href: localePath('/careers', lang), label: t('nav.careers', lang) },
  { href: localePath('/contact', lang), label: t('nav.contact', lang) },
];

const socialLinks = [
  { platform: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/company/블루시큐리티' },
  { platform: 'github', label: 'GitHub', href: 'https://github.com/BlueSecurityCorp' },
  { platform: 'email', label: t('footer.email', lang), href: `mailto:${company.email}` },
];
---

<footer class="site-footer">
  <div class="footer-border-gradient" aria-hidden="true"></div>

  <div class="footer-container">
    <section class="footer-business" aria-label={t('footer.businessInfo', lang)}>
      <dl class="footer-business-list">
        <div class="footer-business-item footer-business-address">
          <dt>{t('footer.address', lang)}</dt>
          <dd><address>{company.address}</address></dd>
        </div>
        <div class="footer-business-item">
          <dt>{t('footer.representative', lang)}</dt>
          <dd>{company.representative}</dd>
        </div>
        <div class="footer-business-item">
          <dt>{t('footer.businessNumber', lang)}</dt>
          <dd>{company.businessRegistrationNumber}</dd>
        </div>
      </dl>
    </section>

    <div class="footer-grid">
      <div class="footer-brand">
        <a href={localePath('/', lang)} class="footer-logo" aria-label={t('nav.home', lang)}>
          <img
            class="footer-logo-image"
            src={blueSecurityWordmark.src}
            alt=""
            width="160"
            height="32"
            loading="lazy"
          />
        </a>

        <p class="footer-slogan">{company.slogan}</p>
        <p class="footer-description">{company.description}</p>

        <div class="footer-social" role="group" aria-label={lang === 'ko' ? '소셜 및 연락처' : 'Social and contact links'}>
          {socialLinks.map((link) => (
            <a
              href={link.href}
              class:list={['social-link', `social-link--${link.platform}`]}
              aria-label={link.label}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {link.platform === 'linkedin' && (
                <svg class="social-link-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M6.5 8.25H3.25v10.5H6.5V8.25Zm.2-3.25A1.85 1.85 0 1 0 3 5a1.85 1.85 0 0 0 3.7 0Zm5.05 3.25H8.63v10.5h3.25v-5.2c0-1.37.26-2.7 1.96-2.7 1.68 0 1.7 1.57 1.7 2.79v5.11h3.25v-5.76c0-2.83-.61-5-3.91-5a3.42 3.42 0 0 0-3.08 1.69h-.05V8.25Z" />
                </svg>
              )}
              {link.platform === 'github' && (
                <svg class="social-link-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.55 9.55 0 0 1 12 6.82c.85 0 1.71.11 2.51.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" clip-rule="evenodd" />
                </svg>
              )}
              {link.platform === 'email' && (
                <svg class="social-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              <span>{link.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="footer-nav-col">
        <h3 class="footer-col-heading">{t('footer.products', lang)}</h3>
        <ul class="footer-nav-list" role="list">
          {products.map((product) => (
            <li>
              <a href={product.href} class="footer-nav-link">
                {product.id === 'codeblue' ? (
                  <img
                    class="footer-product-logo"
                    src={codeBlueWordmark.src}
                    alt="CodeBlue"
                    width="120"
                    height="24"
                    loading="lazy"
                  />
                ) : (
                  <>
                    <span class="footer-link-dot" aria-hidden="true"></span>
                    {product.name}
                    <span class="footer-link-badge">{product.category.split(' ')[0]}</span>
                  </>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-nav-col">
        <h3 class="footer-col-heading">{t('footer.company', lang)}</h3>
        <ul class="footer-nav-list" role="list">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-nav-link">
                <span class="footer-link-dot" aria-hidden="true"></span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-nav-col">
        <h3 class="footer-col-heading">{t('footer.contact', lang)}</h3>
        <ul class="footer-contact-list" role="list">
          <li>
            <a href={`mailto:${company.email}`} class="footer-contact-link">{company.email}</a>
          </li>
          <li class="footer-contact-note">{t('footer.hours', lang)}</li>
        </ul>

        <div class="footer-cta-card">
          <p class="footer-cta-text">{t('footer.contact.prompt', lang)}</p>
          <a href={localePath('/contact', lang)} class="footer-cta-btn bs-marketing-action bs-marketing-action--primary">{t('footer.contact.cta', lang)}</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">&copy; {currentYear} BlueSecurity. All rights reserved.</p>
      <div class="footer-bottom-links">
        <a href={localePath('/privacy', lang)} class="footer-bottom-link">{t('footer.privacy', lang)}</a>
        <span class="footer-divider" aria-hidden="true">/</span>
        <a href={localePath('/terms', lang)} class="footer-bottom-link">{t('footer.terms', lang)}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: auto;
    background-color: var(--color-navy-900);
  }

  .footer-border-gradient {
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--bs-color-primary) 35%, var(--bs-color-tertiary) 50%, var(--bs-color-primary) 65%, transparent 100%);
    opacity: 0.35;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
      gap: 3rem;
    }
  }

  .footer-brand,
  .footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    text-decoration: none;
  }

  .footer-logo-image {
    display: block;
    width: 10rem;
    height: auto;
  }

  .footer-slogan {
    margin: 0;
    color: var(--bs-color-primary);
    font-size: var(--bs-font-size-body-4);
    font-weight: var(--bs-font-weight-semibold);
    letter-spacing: 0.04em;
  }

  .footer-description {
    max-width: 320px;
    margin: 0;
    color: var(--bs-color-text-secondary);
    font-size: var(--bs-font-size-body-4);
    line-height: 1.7;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .social-link,
  .footer-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.4rem;
    text-decoration: none;
    transition: opacity 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .social-link {
    --social-color: var(--bs-color-primary);
    --social-on-color: var(--bs-color-surface-default);
    gap: 0.4rem;
    min-height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--social-color) 28%, var(--bs-color-border-default));
    background-color: color-mix(in srgb, var(--social-color) 7%, var(--bs-color-surface-default));
    padding: 0.45rem 0.7rem;
    color: var(--social-color);
    font-size: var(--bs-font-size-body-4);
    font-weight: var(--bs-font-weight-semibold);
    box-shadow: var(--bs-shadow-sm);
    transition:
      transform var(--bs-duration-fast) var(--bs-ease-standard),
      border-color var(--bs-duration-fast) var(--bs-ease-standard),
      background-color var(--bs-duration-fast) var(--bs-ease-standard),
      color var(--bs-duration-fast) var(--bs-ease-standard),
      box-shadow var(--bs-duration-fast) var(--bs-ease-standard);
  }

  .social-link:hover {
    transform: translateY(-1px);
    border-color: var(--social-color);
    background-color: var(--social-color);
    color: var(--social-on-color);
    box-shadow: var(--bs-shadow-md);
  }

  .social-link:active {
    transform: translateY(0);
  }

  .social-link--linkedin {
    --social-color: #0a66c2;
    --social-on-color: #ffffff;
  }

  .social-link--github {
    --social-color: var(--bs-color-text-primary);
    --social-on-color: var(--bs-color-surface-default);
  }

  .social-link-icon {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .footer-col-heading {
    margin: 0;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--bs-color-border-default);
    color: var(--bs-color-text-tertiary);
    font-size: var(--bs-font-size-body-4);
    font-weight: var(--bs-font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-nav-list,
  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-nav-link,
  .footer-contact-link,
  .footer-contact-note,
  .footer-bottom-link,
  .footer-founded,
  .footer-copyright {
    color: var(--bs-color-text-secondary);
    font-size: var(--bs-font-size-body-4);
    text-decoration: none;
  }

  .footer-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0;
  }

  .footer-nav-link:hover,
  .footer-contact-link:hover,
  .footer-bottom-link:hover {
    color: var(--bs-color-primary);
  }

  .footer-product-logo {
    display: block;
    width: 7.5rem;
    height: auto;
  }

  .footer-link-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--bs-color-primary);
    flex-shrink: 0;
  }

  .footer-link-badge {
    margin-left: auto;
    border: 1px solid var(--bs-color-border-default);
    border-radius: 0.25rem;
    background-color: var(--bs-color-surface-subtle);
    padding: 0.05rem 0.35rem;
    color: var(--bs-color-text-secondary);
    font-size: 0.6875rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .footer-cta-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 0.5rem;
    border: 1px solid var(--bs-color-border-default);
    border-radius: 0.625rem;
    background: var(--bs-color-primary-subtle);
    padding: 0.875rem 1rem;
  }

  .footer-cta-text {
    margin: 0;
    color: var(--bs-color-primary);
    font-size: var(--bs-font-size-body-4);
    font-weight: var(--bs-font-weight-semibold);
  }

  .footer-cta-btn {
    width: fit-content;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.25rem;
    border-top: 1px solid var(--bs-color-border-default);
    padding-top: 1.5rem;
    text-align: center;
  }

  .footer-business {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--bs-color-border-default);
    padding-bottom: 1.5rem;
    text-align: center;
  }

  .footer-business-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
  }

  .footer-business-item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem 0.55rem;
    margin: 0;
  }

  .footer-business-item dt,
  .footer-business-item dd {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .footer-business-item dt {
    color: var(--bs-color-text-tertiary);
    font-weight: var(--bs-font-weight-bold);
    white-space: nowrap;
  }

  .footer-business-item dd,
  .footer-business-item address {
    color: var(--bs-color-text-secondary);
    font-style: normal;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer-bottom-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .footer-copyright,
  .footer-bottom-link,
  .footer-founded,
  .footer-divider {
    color: var(--bs-color-text-tertiary);
    font-size: 0.75rem;
  }

  .footer-divider {
    color: var(--bs-color-border-strong);
  }
</style>
