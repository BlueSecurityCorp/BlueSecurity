---
import type { Locale } from '../i18n/index';
import blueSecurityWordmark from '@bluesecuritycorp/brand/bluesecurity-wordmark.png';
import codeBlueWordmark from '@bluesecuritycorp/brand/codeblue-wordmark.png';
import { localePath, switchLocalePath } from '../i18n/index';
import { t } from '../i18n/ui';
import { getProductLineup } from '../data/products';

interface Props {
  lang?: Locale;
}

const { lang = 'ko' } = Astro.props;
const products = getProductLineup(lang);
const currentPath = Astro.url.pathname;
const koPath = switchLocalePath(currentPath, 'ko');
const enPath = switchLocalePath(currentPath, 'en');

function isActive(path: string) {
  const localizedPath = currentPath.replace(/^\/en(?=\/|$)/, '') || '/';
  return path === '/' ? localizedPath === '/' : localizedPath.startsWith(path);
}
---

<header class="site-header">
  <nav class="nav-inner">
    <a href={localePath('/', lang)} class="brand" aria-label={t('nav.home', lang)}>
      <img
        class="brand-logo"
        src={blueSecurityWordmark.src}
        alt=""
        width="160"
        height="32"
        fetchpriority="high"
      />
    </a>

    <input id="mobile-menu-toggle" class="menu-checkbox" type="checkbox" aria-hidden="true" />
    <button
      type="button"
      class="menu-toggle"
      aria-label="메뉴 열기"
      aria-controls="primary-navigation"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>

    <div id="primary-navigation" class="nav-links">
      <a href={localePath('/about', lang)} class:list={['nav-link', { active: isActive('/about') }]}>{t('nav.about', lang)}</a>

      <div class="products-menu">
        <a href={localePath('/products', lang)} class:list={['nav-link', { active: isActive('/products') }]}>{t('nav.products', lang)}</a>
        <div class="products-dropdown">
          <p>{t('nav.products.lineup', lang)}</p>
          {products.map((product) => (
            <a href={product.href} class="product-link">
              {product.id === 'codeblue' ? (
                <img
                  class="product-wordmark"
                  src={codeBlueWordmark.src}
                  alt={product.name}
                  width="140"
                  height="28"
                />
              ) : (
                <strong>{product.name}</strong>
              )}
              <span>{product.tagline}</span>
            </a>
          ))}
          <a href={localePath('/pricing', lang)} class="product-link pricing-link">{t('nav.pricing.view', lang)}</a>
        </div>
      </div>

      <a href={localePath('/pricing', lang)} class:list={['nav-link', { active: isActive('/pricing') }]}>{t('nav.pricing', lang)}</a>
      <a href={localePath('/news', lang)} class:list={['nav-link', { active: isActive('/news') }]}>{t('nav.news', lang)}</a>
      <a href={localePath('/notices', lang)} class:list={['nav-link', { active: isActive('/notices') }]}>{t('nav.notices', lang)}</a>
      <a href={localePath('/careers', lang)} class:list={['nav-link', { active: isActive('/careers') }]}>{t('nav.careers', lang)}</a>
      <a href={localePath('/contact', lang)} class="nav-cta bs-marketing-action bs-marketing-action--primary">{t('nav.contact', lang)}</a>

      <div class="lang-switch" aria-label="Language">
        <a href={koPath} class:list={[{ active: lang === 'ko' }]} hreflang="ko">KO</a>
        <span>|</span>
        <a href={enPath} class:list={[{ active: lang === 'en' }]} hreflang="en">EN</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuCheckbox = document.querySelector<HTMLInputElement>('#mobile-menu-toggle');
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');

  if (menuCheckbox && menuToggle) {
    const syncMenuState = () => {
      menuToggle.setAttribute('aria-expanded', String(menuCheckbox.checked));
      menuToggle.setAttribute('aria-label', menuCheckbox.checked ? '메뉴 닫기' : '메뉴 열기');
    };

    menuToggle.addEventListener('click', () => {
      menuCheckbox.checked = !menuCheckbox.checked;
      syncMenuState();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--bs-color-border-default);
    background: color-mix(in srgb, var(--bs-color-surface-default) 92%, transparent);
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    height: 64px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    width: 10rem;
    height: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link,
  .nav-cta,
  .lang-switch a,
  .product-link {
    text-decoration: none;
  }

  .nav-link {
    border-radius: var(--bs-radius-lg);
    padding: var(--bs-space-2) var(--bs-space-3);
    color: var(--bs-color-text-secondary);
    font-size: var(--bs-font-size-body-3);
    font-weight: var(--bs-font-weight-medium);
  }

  .nav-link:hover,
  .nav-link.active {
    background: var(--bs-color-primary-subtle);
    color: var(--bs-color-primary);
  }

  .products-menu {
    position: relative;
  }

  .products-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    display: none;
    width: 300px;
    transform: translateX(-50%);
    border: 1px solid var(--bs-color-border-default);
    border-radius: var(--bs-radius-xl);
    background: var(--bs-color-surface-raised);
    padding: var(--bs-space-2);
    box-shadow: var(--bs-shadow-lg);
  }

  .products-menu:hover .products-dropdown,
  .products-menu:focus-within .products-dropdown {
    display: block;
  }

  .products-dropdown p {
    margin: 0;
    padding: 0.35rem 0.6rem;
    color: var(--bs-color-text-tertiary);
    font-size: var(--bs-font-size-body-4);
    font-weight: var(--bs-font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-link {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    border-radius: var(--bs-radius-lg);
    padding: 0.65rem 0.75rem;
    color: var(--bs-color-text-primary);
  }

  .product-link:hover {
    background: var(--bs-color-primary-subtle);
  }

  .product-link span {
    color: var(--bs-color-text-tertiary);
    font-size: var(--bs-font-size-body-4);
  }

  .product-wordmark {
    display: block;
    width: 8.75rem;
    height: auto;
    margin-bottom: 0.15rem;
  }

  .pricing-link {
    margin-top: 0.35rem;
    border-top: 1px solid var(--bs-color-border-default);
    color: var(--bs-color-primary);
    font-size: var(--bs-font-size-body-4);
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.5rem;
  }

  .lang-switch a,
  .lang-switch span {
    color: var(--bs-color-text-tertiary);
    font-size: var(--bs-font-size-body-4);
    font-weight: var(--bs-font-weight-semibold);
  }

  .lang-switch a.active {
    color: var(--bs-color-primary);
  }

  .menu-checkbox,
  .menu-toggle {
    display: none;
  }

  @media (max-width: 767px) {
    .menu-toggle {
      display: flex;
      flex-direction: column;
      gap: 5px;
      border: 0;
      background: transparent;
      padding: 0;
      cursor: pointer;
    }

    .menu-toggle span {
      display: block;
      width: 22px;
      height: 2px;
      border-radius: 2px;
      background: var(--bs-color-text-secondary);
    }

    .nav-links {
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      border-top: 1px solid var(--bs-color-border-default);
      background: var(--bs-color-surface-default);
      padding: 1rem;
    }

    .menu-checkbox:checked ~ .nav-links {
      display: flex;
    }

    .products-dropdown {
      position: static;
      display: block;
      width: auto;
      transform: none;
      box-shadow: none;
    }
  }
</style>
