---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NewsArticle from '../../components/NewsArticle.astro';
import PreviewNewsArticle from '../../components/PreviewNewsArticle.astro';
import type { Locale } from '../../i18n/index';
import { previewNews } from '../../data/previewNews';

const lang = 'ko' as Locale;

export async function getStaticPaths() {
  const items = await getCollection('news');
  const contentPaths = items
    .filter((item) => {
      if (item.id.split('/').pop()?.startsWith('_')) return false;
      return item.data.published && item.data.lang === 'ko';
    })
    .map((news) => ({
      params: { slug: news.id.replace(/\.mdx?$/, '') },
      props: { news },
    }));

  const previewPaths = previewNews.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));

  return [...previewPaths, ...contentPaths];
}

const { news, article } = Astro.props;
const pageTitle = article?.title ?? news?.data.title;
const pageDescription = article?.description ?? news?.data.description;
---

<Layout
  title={`${pageTitle} | BlueSecurity`}
  description={pageDescription}
  ogImage={news?.data.image}
  lang={lang}
  alternateLanguages={false}
>
  <Header slot="header" lang={lang} />
  {article ? <PreviewNewsArticle article={article} lang={lang} /> : <NewsArticle news={news} lang={lang} />}
  <Footer slot="footer" lang={lang} />
</Layout>
