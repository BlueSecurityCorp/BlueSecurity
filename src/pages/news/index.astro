---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NewsBoard from '../../components/NewsBoard.astro';
import type { Locale } from '../../i18n/index';
import { t } from '../../i18n/ui';

const lang = 'ko' as Locale;
---

<Layout title={t('news.title', lang)} description={t('news.meta', lang)} lang={lang}>
  <Header slot="header" lang={lang} />

  <div data-pagefind-body>
    <section class="news-hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="hero-eyebrow">
            <span></span>
            {t('news.eyebrow', lang)}
          </p>
          <h1>{t('news.heading', lang)}</h1>
          <p class="hero-description">{t('news.subtitle', lang)}</p>
        </div>

        <div class="briefing-mark" aria-hidden="true">
          <div class="mark-orbit orbit-outer"></div>
          <div class="mark-orbit orbit-inner"></div>
          <div class="mark-core">
            <svg width="42" height="42" viewBox="0 0 48 48" fill="none">
              <path d="M10 9h28v30H10z" stroke="currentColor" stroke-width="1.5" />
              <path d="M16 17h16M16 23h16M16 29h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <path d="M29 29h3v3h-3z" fill="currentColor" />
            </svg>
          </div>
          <span class="mark-label">BLUESECURITY<br />BRIEFING</span>
        </div>
      </div>
    </section>

    <NewsBoard lang={lang} />
  </div>

  <Footer slot="footer" lang={lang} />
</Layout>

<style>
  .news-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(51, 65, 85, 0.5);
    background: #0a0f1c;
    padding: 5.5rem 0 4.75rem;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.55;
    background-image: linear-gradient(rgba(59, 130, 246, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(59, 130, 246, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to right, black, transparent 75%);
  }

  .hero-glow {
    position: absolute;
    top: -180px;
    right: 7%;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.11);
    filter: blur(70px);
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    width: min(1200px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .hero-copy { max-width: 720px; }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.25rem;
    color: #60a5fa;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-eyebrow span {
    display: block;
    width: 1.7rem;
    height: 1px;
    background: linear-gradient(90deg, #3b82f6, #22d3ee);
  }

  h1 {
    max-width: 680px;
    margin: 0;
    color: #f8fafc;
    font-size: clamp(2.35rem, 5vw, 4.15rem);
    font-weight: 680;
    line-height: 1.15;
    letter-spacing: -0.045em;
  }

  .hero-description {
    max-width: 580px;
    margin: 1.4rem 0 0;
    color: #8795aa;
    font-size: 1rem;
    line-height: 1.75;
  }

  .briefing-mark { display: none; }

  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: minmax(0, 1fr) 300px; gap: 4rem; }

    .briefing-mark {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 250px;
      height: 250px;
      justify-self: end;
      color: #60a5fa;
    }

    .mark-orbit {
      position: absolute;
      border: 1px solid rgba(96, 165, 250, 0.14);
      border-radius: 50%;
    }

    .orbit-outer { inset: 0; }
    .orbit-inner { inset: 32px; border-style: dashed; }

    .mark-core {
      position: relative;
      display: grid;
      place-items: center;
      width: 100px;
      height: 100px;
      border: 1px solid rgba(96, 165, 250, 0.32);
      border-radius: 50%;
      background: rgba(37, 99, 235, 0.08);
      box-shadow: 0 0 45px rgba(37, 99, 235, 0.15);
    }

    .mark-label {
      position: absolute;
      right: -12px;
      bottom: 38px;
      color: #526078;
      font-family: var(--font-mono);
      font-size: 0.55rem;
      line-height: 1.45;
      letter-spacing: 0.12em;
    }
  }

  @media (max-width: 639px) {
    .news-hero { padding: 4.5rem 0 3.8rem; }
    .hero-inner { width: min(100% - 2rem, 1200px); }
  }
</style>
