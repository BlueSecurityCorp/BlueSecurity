---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingTable from '../components/PricingTable.astro';
import type { Locale } from '../i18n/index';
import { t } from '../i18n/ui';
import { getFaq } from '../data/pricing';

const lang = 'ko' as Locale;
const faq = getFaq(lang);
---

<Layout
  description={t('pricing.meta', lang)}
>
  <Header slot="header" lang={lang} />

  <!-- Hero -->
  <section class="border-b border-slate-800 bg-navy-900 pt-24 pb-10">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-blue-300">
        Pricing
      </p>
      <h1 class="max-w-3xl text-4xl font-semibold leading-tight text-white sm:text-5xl">
        {t('pricing.heading', lang)}
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-slate-400">
        {t('pricing.subtitle', lang)}
      </p>
    </div>
  </section>

  <!-- Pricing Table -->
  <section class="border-b border-slate-800 bg-navy-900 py-12">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <PricingTable lang={lang} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-b border-slate-800 bg-slate-950/40 py-12">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mb-8 grid gap-4 lg:grid-cols-[320px_1fr] lg:items-end">
        <p class="text-sm font-semibold uppercase tracking-widest text-blue-300">FAQ</p>
        <h2 class="text-3xl font-semibold text-white sm:text-4xl">{t('pricing.faq.heading', lang)}</h2>
      </div>

      <div class="max-w-3xl space-y-3">
        {
          faq.map((item) => (
            <details class="group overflow-hidden rounded-lg border border-slate-800 bg-navy-900">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left select-none transition-colors duration-150 hover:bg-slate-950/50">
                <span class="font-semibold text-white text-sm sm:text-base">
                  {item.question}
                </span>
                {/* Chevron icon — rotates when open via CSS */}
                <svg
                  class="h-5 w-5 shrink-0 text-blue-300 transition-transform duration-200 group-open:rotate-180"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M5 8l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="px-5 pb-5">
                <div class="h-px w-full bg-slate-800 mb-4" />
                <p class="text-sm leading-6 text-slate-400">{item.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Footer slot="footer" lang={lang} />
</Layout>
