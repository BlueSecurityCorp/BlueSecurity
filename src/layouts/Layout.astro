---
import type { Locale } from '../i18n/index';
import { switchLocalePath } from '../i18n/index';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: Locale;
  alternateLanguages?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'BlueSecurity - 한국 중소기업을 위한 기업급 사이버보안 솔루션',
  ogImage = '/og/default.svg',
  lang = 'ko',
  alternateLanguages = true,
  noindex = false,
} = Astro.props;

const siteURL = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImageURL = new URL(ogImage, siteURL);
const ogLocale = lang === 'en' ? 'en_US' : 'ko_KR';

function localizedURL(path: string) {
  const url = new URL(path, siteURL);
  if (!url.pathname.endsWith('/')) {
    url.pathname = `${url.pathname}/`;
  }
  return url;
}

const alternateURLs = {
  ko: localizedURL(switchLocalePath(Astro.url.pathname, 'ko')),
  en: localizedURL(switchLocalePath(Astro.url.pathname, 'en')),
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BlueSecurity',
  url: siteURL.toString(),
  logo: new URL('/icons/favicon.svg', siteURL).toString(),
  email: 'blue@bluesecurity.online',
  sameAs: [
    'https://github.com/BlueSecurityCorp',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="naver-site-verification" content="82d96ff45ecb1d22075e35781f7fda300d0950e0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonicalURL} />
    {alternateLanguages && (
      <>
        <link rel="alternate" hreflang="ko" href={alternateURLs.ko} />
        <link rel="alternate" hreflang="en" href={alternateURLs.en} />
        <link rel="alternate" hreflang="x-default" href={alternateURLs.ko} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={ogLocale} />
    {alternateLanguages && lang === 'ko' && <meta property="og:locale:alternate" content="en_US" />}
    {alternateLanguages && lang === 'en' && <meta property="og:locale:alternate" content="ko_KR" />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />

    <!-- Pretendard Font -->
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      integrity="sha384-GIdEBaqGN9mNkDkMkzMHW8EKUqtpPIe/sLj1X7DIrnc9uPtLROJgmuDlh+3rBw0j"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen bg-navy-900 text-slate-200 antialiased">
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />

    <!-- Cloudflare Web Analytics -->
    <!-- <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "YOUR_TOKEN"}'></script> -->
  </body>
</html>

<style is:global>
  @import '../styles/globals.css';
</style>
